    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-workflow-harness/hooks/lint-check.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-workflow-harness/hooks/format-on-write.sh\""
          }
        ]
      }
    ]
  }
}
