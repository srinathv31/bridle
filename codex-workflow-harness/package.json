{
  "name": "codex-workflow-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "App-agnostic multi-agent build/QA harness for OpenAI Codex (CLI + IDE extension). One command installs the trust scripts, repo-scoped skills, the AGENTS.md block, and a deterministic codex-exec conductor into any repo. Plain Node (exit code is the contract) + a config manifest + a pluggable runtime verifier.",
  "bin": {
    "codex-workflow-harness": "install.mjs"
  },
  "files": [
    "install.mjs",
    "lib",
    "scripts",
    "verifiers",
    "hooks",
    "templates",
    "roles",
    "codex",
    "harness.config.example.json",
    "harness.config.schema.json",
    "README.md",
    "INSTALL.md",
    "PREFLIGHT.md"
  ],
  "scripts": {
    "install-into": "node install.mjs",
    "drive-phase": "node codex/drive-phase.mjs",
    "phase-items": "node scripts/phase-items.mjs",
    "precheck": "node scripts/precheck.mjs",
    "run-gate": "node scripts/run-gate.mjs",
    "qa-check": "node scripts/qa-check.mjs",
    "phase-guard": "node scripts/phase-guard.mjs",
    "subagent-status": "node scripts/subagent-status.mjs",
    "hook-selftest": "node scripts/hook-selftest.mjs"
  },
  "optionalDependencies": {
    "playwright-core": "^1.60.0"
  },
  "engines": {
    "node": ">=18"
  }
}
